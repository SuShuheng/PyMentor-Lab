# ---- Secrets / local config (never commit) ----
.env
.env.*
!.env.example
*.local.yaml
local.yaml

# ---- Node / pnpm ----
node_modules/
.vite/
out/
dist/
build/
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Generated artifacts ----
# NOTE: packages/api-client/src/generated/ IS committed on purpose. The
# freshness gate (pnpm freshness) regenerates it and fails on diff, so a
# stale client cannot merge. Renderers consume the committed client directly.

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Competition raw inputs (design-only, not runtime) ----
raw/

# ---- Local worktrees / agent tooling (never commit) ----
.worktrees/
.zcode/
.pnpm-store/

# ---- Build / distribution outputs ----
# `dist/` is ENTIRELY generated by compose_mee.bat + compose/build-dist.mjs +
# ISCC. Nothing under dist/ is tracked. Source scripts live under compose/.
# The top-level `dist/` rule above already covers this; the comment is here
# to make the intent explicit.

# ---- Compose source (tracked) vs. its generated outputs (not tracked) ----
# compose/ holds the build scripts and deployment-kit source:
#   compose/build-dist.mjs              ZIP assembler (Node, no deps)
#   compose/bootstrapper.iss            Inno Setup installer source
#   compose/README.md                   compose docs
#   compose/backend-deploy/             self-contained backend kit source:
#     {.env.example, docker-compose.yml, README.md, *.ps1, *.sh}
# These source files ARE tracked. Only the generated artifacts that
# build-dist.mjs emits inside compose/backend-deploy/ are ignored:
compose/backend-deploy/code/
compose/backend-deploy/*.zip
