; ===========================================================================
;  PyMentor Lab - Bootstrapper (Stage D, v2)
;  --------------------------------------------------------------------------
;  Single Inno Setup wrapper that:
;    1. Runs the Electron student app installer (PyMentorLab-Setup.exe,
;       Squirrel.Windows /SILENT)                         -- component `main`
;    2. Unpacks the backend deployment kit to Documents\PyMentorLab-Backend
;       after verifying Docker Desktop is available        -- component `backend`
;
;  Backend deploy UX (revised):
;    - A custom wizard page collects ADMIN_EMAIL / ADMIN_PASSWORD and offers
;      to auto-generate PROVIDER_MASTER_KEY. The values are written into
;      .env before the user is asked to run deploy.ps1.
;    - Docker is probed INLINE from PascalScript (no external .ps1 file),
;      which fixes the -196608 exit code caused by the previous design
;      running the probe before [Files] had extracted check-docker.ps1.
;    - PYMENTOR_DESKTOP_WEB_URL is set as a machine environment variable
;      (HKLM\...\Session Env\Environment) so the desktop shell finds the
;      student web frontend without manual configuration. Uses 127.0.0.1,
;      never localhost, per deployment convention.
;    - The backend is NEVER auto-started. deploy.ps1 is offered as a one-
;      click shortcut (with port-occupancy handling built in).
;
;  Build:
;    "F:/Tools/Inno-Setup6/ISCC.exe" dist/installer-source/bootstrapper.iss
;  Output:
;    dist/installer/PyMentorLab-Bootstrapper.exe
; ===========================================================================

#define MyAppName      "PyMentor Lab"
#define MyAppVersion   "1.1.0"
#define MyAppPublisher "PyMentor Lab"

[Setup]
AppId={{PyMentorLab-Bootstrapper}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={commonpf}\PyMentorLab
DefaultGroupName={#MyAppPublisher}
DisableDirPage=yes
DisableProgramGroupPage=yes
DisableReadyPage=no
DisableReadyMemo=no
; Program Files install; requires admin so we can write HKLM env vars.
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible

OutputDir=..\dist\installer
OutputBaseFilename=PyMentorLab-Bootstrapper

Compression=lzma2/ultra64
SolidCompression=yes
LZMAUseSeparateProcess=yes

WizardStyle=modern
ShowLanguageDialog=no

; Icons + embedded assets live under dist/installer-source/ (generated by
; compose_mee.bat). This .iss file lives under compose/, so we reference them
; via the relative ../dist/installer-source/ path.
SetupIconFile=..\dist\installer-source\icon.ico
UninstallDisplayIcon={app}\icon.ico

UninstallDisplayName={#MyAppName} Bootstrapper {#MyAppVersion}

; Note: ChineseSimplified.isl is not bundled with Inno Setup 6.7.3, so the
; wizard chrome falls back to the built-in English (Default.isl). Our custom
; PascalScript MsgBox / StatusMsg strings are still rendered in Simplified
; Chinese for end-user clarity.

[Types]
Name: "full"; Description: "完整安装（学生端 + 后端部署）"
Name: "custom"; Description: "自定义安装"; Flags: iscustom

[Components]
; `main` is fixed: the student app is the primary deliverable.
Name: "main";    Description: "学生端主程序（PyMentor Lab 桌面应用）";                   Types: full custom; Flags: fixed
Name: "backend"; Description: "后端服务部署（需要 Docker Desktop，将自动配置 .env 并引导启动）";  Types: full

[Files]
; --- main: the Electron installer. Copied to {tmp} and run from there. ---
Source: "..\dist\installer-source\installer-assets\PyMentorLab-Setup.exe"; DestDir: "{tmp}"; Components: main;    Flags: nocompression deleteafterinstall
; --- backend: deployment kit. ---
Source: "..\dist\installer-source\installer-assets\backend-deploy.zip";    DestDir: "{app}\backend"; Components: backend; Flags: nocompression ignoreversion
; --- keep the brand icon alongside {app} for the uninstall display icon. ---
Source: "..\dist\installer-source\icon.ico"; DestDir: "{app}"; Flags: ignoreversion

[Run]
; --- main: silent Squirrel install of the student app. ---
Filename: "{tmp}\PyMentorLab-Setup.exe"; Parameters: "/SILENT /NORESTART"; \
  Components: main; StatusMsg: "正在安装学生端主程序…"; \
  Flags: waituntilterminated runhidden

; --- Uninstall: remove the machine env var we set during install. ---
;    (Declared here as a placeholder; the actual [Registry] entry below
;    handles both install + uninstall atomically.)

[Registry]
; Set PYMENTOR_DESKTOP_WEB_URL as a SYSTEM (HKLM) environment variable so
; every user + every newly-spawned process sees it. The desktop shell reads
; this on startup to know where the student web app lives.
;
; Bound to the `backend` component: only when the user deploys the backend do
; we know the student web frontend will live at 127.0.0.1:4173. A `main`-only
; install leaves the env var unset so the desktop shell shows its "configure
; me" fallback page (the operator can set the var by hand for remote backends).
;
;   Root: HKLM  -> machine-wide (every user sees it).
;   Subkey: System\CurrentControlSet\Control\Session Manager\Environment
;          (the canonical Windows machine-environment location).
;   Flags: uninsdeletevalue -> cleaned up on uninstall.
Root: HKLM; Subkey: "System\CurrentControlSet\Control\Session Manager\Environment"; \
  ValueType: string; ValueName: "PYMENTOR_DESKTOP_WEB_URL"; ValueData: "{code:GetDesktopWebUrl}"; \
  Components: backend; Flags: uninsdeletevalue

[Code]
const
  DOCKER_DOWNLOAD_URL = 'https://www.docker.com/products/docker-desktop/';
  DEFAULT_DESKTOP_URL = 'http://127.0.0.1:4173';
  BACKEND_DOCS_URL    = 'docs/deployment/backend-deploy-windows.md';

var
  // Component + page state.
  BackendSelected: Boolean;
  // The custom wizard page handle (created in InitializeWizard).
  EnvPage: TInputQueryWizardPage;
  // Captured inputs (saved at NextButtonClick time so [Registry] code helpers
  // and CurStepChanged can both read them).
  AdminEmail: String;
  AdminPassword: String;
  MasterKey: String;
  // User's chosen desktop URL (defaults to DEFAULT_DESKTOP_URL; user may
  // override if they deploy the backend elsewhere).
  DesktopWebUrl: String;
  // Result of the inline Docker probe (set in CurStepChanged).
  DockerReady: Boolean;

// ===========================================================================
// Pure helpers (defined first so callers below can reference them).
// ===========================================================================

// Replace (or append) KEY=... in env text. Keeps comments intact. Only matches
// a leading "KEY=" or commented "# KEY=" so partial-name collisions cannot
// happen (e.g. PYMENTOR_INITIAL_ADMIN_EMAIL vs PYMENTOR_INITIAL_ADMIN_PASSWORD).
function ReplaceEnvKey(Text, Key, Value: String): String;
var
  Lines: TArrayOfString;
  Separators: TArrayOfString;
  i: Integer;
  Found: Boolean;
  NewLine: String;
  Joined: String;
begin
  Result := Text;

  // StringSplit wants TArrayOfString for separators; accept both CRLF and LF.
  SetArrayLength(Separators, 2);
  Separators[0] := #13#10;
  Separators[1] := #10;
  Lines := StringSplit(Text, Separators, stAll);

  Found := False;
  NewLine := Key + '=' + Value;
  for i := 0 to GetArrayLength(Lines) - 1 do begin
    if (Pos(Key + '=', Lines[i]) = 1) or (Pos('# ' + Key + '=', Lines[i]) = 1) then begin
      Lines[i] := NewLine;
      Found := True;
    end;
  end;
  if not Found then begin
    SetArrayLength(Lines, GetArrayLength(Lines) + 1);
    Lines[GetArrayLength(Lines) - 1] := NewLine;
  end;

  Joined := '';
  for i := 0 to GetArrayLength(Lines) - 1 do begin
    if i > 0 then Joined := Joined + #13#10;
    Joined := Joined + Lines[i];
  end;
  Result := Joined;
end;

// Generate a URL-safe base64 AES-256 key (32 random bytes) via PowerShell.
// Returns the base64 string, or '' on any failure.
function GenerateMasterKey: String;
var
  ResultCode: Integer;
  TmpFile: String;
  PsCmd: String;
  Contents: AnsiString;
begin
  Result := '';
  TmpFile := ExpandConstant('{tmp}\pymentor-masterkey.txt');

  // Write the base64 key to a temp file; PascalScript cannot easily capture
  // stdout, so this round-trip is the robust path.
  PsCmd := '-NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference=''Stop''; ' +
           '[System.Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 })) ' +
           '| Set-Content -Path ''' + TmpFile + ''' -NoNewline -Encoding ascii"';

  if not Exec(ExpandConstant('{cmd}'), '/c powershell.exe ' + PsCmd,
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    Exit;
  if ResultCode <> 0 then
    Exit;
  if not FileExists(TmpFile) then
    Exit;
  if LoadStringFromFile(TmpFile, Contents) then begin
    Result := Trim(Contents);
  end;
  // Best-effort cleanup; ignore failures.
  DeleteFile(TmpFile);
end;

// Probe Docker Desktop: is docker.exe on PATH, daemon reachable, compose plugin
// present? Sets global DockerReady and returns a human-readable status string.
//   0 = OK
//   1 = docker not installed
//   2 = daemon not running
//   3 = compose plugin missing
//   4 = unexpected error
function ProbeDocker(var StatusMsg: String): Integer;
var
  ResultCode: Integer;
begin
  // 1. docker.exe present?
  if not Exec(ExpandConstant('{cmd}'), '/c where docker >nul 2>nul',
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then begin
    StatusMsg := '无法执行 docker 命令。';
    Result := 4;
    Exit;
  end;
  if ResultCode <> 0 then begin
    StatusMsg := '未检测到 Docker Desktop。';
    Result := 1;
    Exit;
  end;

  // 2. daemon running?
  if not Exec(ExpandConstant('{cmd}'), '/c docker info >nul 2>nul',
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then begin
    StatusMsg := '无法执行 docker info。';
    Result := 4;
    Exit;
  end;
  if ResultCode <> 0 then begin
    StatusMsg := 'Docker Desktop 已安装但守护进程未运行。';
    Result := 2;
    Exit;
  end;

  // 3. compose plugin?
  if not Exec(ExpandConstant('{cmd}'), '/c docker compose version >nul 2>nul',
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then begin
    StatusMsg := '无法执行 docker compose version。';
    Result := 4;
    Exit;
  end;
  if ResultCode <> 0 then begin
    StatusMsg := '未检测到 docker compose 插件。';
    Result := 3;
    Exit;
  end;

  StatusMsg := 'Docker OK。';
  DockerReady := True;
  Result := 0;
end;

// Write .env into the unpacked backend directory using the captured inputs.
// Returns True on success.
function WriteEnvFile(BackendDir: String): Boolean;
var
  EnvPath: String;
  Template: AnsiString;
  Content: AnsiString;
begin
  Result := False;
  EnvPath := BackendDir + '\.env';

  // Load .env.example as the template (it ships in the zip).
  if not FileExists(BackendDir + '\.env.example') then begin
    Log('WriteEnvFile: .env.example missing in ' + BackendDir);
    Exit;
  end;
  if not LoadStringFromFile(BackendDir + '\.env.example', Template) then begin
    Log('WriteEnvFile: failed to load .env.example');
    Exit;
  end;

  Content := Template;
  // Replace the three required placeholders. We use simple line substitution
  // because the .env is line-oriented KEY=VALUE.
  Content := ReplaceEnvKey(Content, 'PYMENTOR_PROVIDER_MASTER_KEY', MasterKey);
  Content := ReplaceEnvKey(Content, 'PYMENTOR_INITIAL_ADMIN_EMAIL', AdminEmail);
  Content := ReplaceEnvKey(Content, 'PYMENTOR_INITIAL_ADMIN_PASSWORD', AdminPassword);
  // Tighten CORS to 127.0.0.1 only (already the example default, but enforce).
  Content := ReplaceEnvKey(Content, 'PYMENTOR_CORS_ALLOWED_ORIGINS',
                            'http://127.0.0.1:4173,http://127.0.0.1:4174');

  if not SaveStringToFile(EnvPath, Content, False) then begin
    Log('WriteEnvFile: failed to write ' + EnvPath);
    Exit;
  end;
  Result := True;
end;

// ===========================================================================
// Helpers exposed to [Registry] via {code:...}.
// ===========================================================================
function GetDesktopWebUrl(Param: String): String;
begin
  if DesktopWebUrl = '' then
    Result := DEFAULT_DESKTOP_URL
  else
    Result := DesktopWebUrl;
end;

// ===========================================================================
// Wizard page: collect admin credentials + optional desktop URL.
// ===========================================================================
procedure InitializeWizard;
begin
  DesktopWebUrl := DEFAULT_DESKTOP_URL;

  EnvPage := CreateInputQueryPage(wpSelectComponents,
    '后端部署配置',
    '请填写首次部署所需的管理员账号与密钥（仅写入本地 .env，不会上传）。',
    '点击“下一步”将这些值写入后端部署目录的 .env 文件。');

  EnvPage.Add('管理员邮箱（必须是可投递邮箱，例如 admin@pymentor.dev）：', False);
  EnvPage.Add('管理员密码（至少 8 位）：', True);
  EnvPage.Add('Provider 主密钥（留空将自动生成 32 字节 base64 密钥）：', True);
  EnvPage.Add('学生端 Web 地址（桌面应用加载的 URL，默认 127.0.0.1:4173）：', False);

  // Pre-fill the desktop URL so the user sees the default.
  EnvPage.Values[3] := DEFAULT_DESKTOP_URL;
end;

// Skip the env page entirely when the backend component is not selected.
function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if (PageID = EnvPage.ID) and (not WizardIsComponentSelected('backend')) then
    Result := True;
end;

// Validate inputs before leaving the env page.
function NextButtonClick(CurPageID: Integer): Boolean;
var
  Email, Pwd, Key, UrlVal: String;
  AtPos, DotPos: Integer;
begin
  Result := True;

  if CurPageID = EnvPage.ID then begin
    Email := Trim(EnvPage.Values[0]);
    Pwd   := EnvPage.Values[1];
    Key   := Trim(EnvPage.Values[2]);
    UrlVal := Trim(EnvPage.Values[3]);

    // Email: must contain '@' and a '.' in the domain part.
    AtPos := Pos('@', Email);
    if (AtPos < 2) then begin
      MsgBox('管理员邮箱格式不正确：缺少 @ 或用户名。请使用形如 admin@pymentor.dev 的可投递邮箱。',
             mbError, MB_OK);
      Result := False;
      Exit;
    end;
    DotPos := Pos('.', Copy(Email, AtPos + 1, Length(Email)));
    if DotPos = 0 then begin
      MsgBox('管理员邮箱域名缺少点号（.）。请使用形如 admin@pymentor.dev 的可投递邮箱。' + #13#10 +
             '注意：admin@*.local 等保留 TLD 会被后端 EmailStr 校验拒绝。',
             mbError, MB_OK);
      Result := False;
      Exit;
    end;

    // Password: min 8 chars.
    if Length(Pwd) < 8 then begin
      MsgBox('管理员密码至少 8 位。', mbError, MB_OK);
      Result := False;
      Exit;
    end;

    // Master key: if provided, sanity-check length (base64 of 32 bytes ~= 44 chars).
    if (Key <> '') and (Length(Key) < 32) then begin
      MsgBox('Provider 主密钥看起来过短（应为 base64 编码的 32 字节，约 44 字符）。' + #13#10 +
             '留空可由安装程序自动生成。', mbError, MB_OK);
      Result := False;
      Exit;
    end;
    // If empty, auto-generate using PowerShell so we do not depend on a fixed
    // key being committed anywhere.
    if Key = '' then begin
      Key := GenerateMasterKey;
      if Key = '' then begin
        MsgBox('无法自动生成 Provider 主密钥。请在字段中手动填入 base64 编码的 32 字节密钥。',
               mbError, MB_OK);
        Result := False;
        Exit;
      end;
      MsgBox('已自动生成 Provider 主密钥（将写入 .env）：' + #13#10 + #13#10 + Key,
             mbInformation, MB_OK);
    end;

    // Desktop URL: must start with http://127.0.0.1 or https://.
    if (Pos('http://127.0.0.1', UrlVal) <> 1) and (Pos('https://', UrlVal) <> 1) then begin
      MsgBox('学生端 Web 地址必须以 http://127.0.0.1 或 https:// 开头。' + #13#10 +
             '本地部署默认：http://127.0.0.1:4173', mbError, MB_OK);
      Result := False;
      Exit;
    end;

    // Persist for later steps.
    AdminEmail := Email;
    AdminPassword := Pwd;
    MasterKey := Key;
    DesktopWebUrl := UrlVal;
  end;
end;

// ===========================================================================
// Post-install: unpack the backend kit, probe Docker, write .env, and offer
// to launch deploy.ps1 (which handles port-occupancy itself).
// Runs AFTER all [Files] have been copied and AFTER the [Run] student-app step.
// ===========================================================================
procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
  BackendDir: String;
  ExpandCmd: String;
  Msg: String;
  OpenFolder: Integer;
  DockerStatus: String;
  DockerCode: Integer;
  LaunchDeploy: Integer;
begin
  if CurStep <> ssPostInstall then Exit;
  BackendSelected := WizardIsComponentSelected('backend');
  if not BackendSelected then Exit;

  BackendDir := ExpandConstant('{userdocs}\PyMentorLab-Backend');

  // 1. Expand-Archive the backend kit. -Force overwrites prior extracts.
  ExpandCmd := '-NoProfile -ExecutionPolicy Bypass -Command "'
             + 'Expand-Archive -Path ''' + ExpandConstant('{app}\backend\backend-deploy.zip') + ''''
             + ' -DestinationPath ''' + BackendDir + ''' -Force'
             + '"';
  if not Exec(ExpandConstant('{cmd}'), '/c powershell.exe ' + ExpandCmd,
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then begin
    MsgBox('解压后端部署包失败 (ExitCode=' + IntToStr(ResultCode) + ')。' + #13#10
         + '请稍后手动解压 {app}\backend\backend-deploy.zip。',
           mbError, MB_OK);
    Exit;
  end;

  // 2. Probe Docker INLINE (no external .ps1) AFTER files are extracted.
  DockerStatus := '';
  DockerCode := ProbeDocker(DockerStatus);

  // 3. Write .env with the captured credentials (do this regardless of Docker
  //    status, so the user can fix Docker later without re-running setup).
  if not WriteEnvFile(BackendDir) then begin
    MsgBox('警告：无法自动写入 .env。请手动复制 .env.example 为 .env 并填入：' + #13#10
         + '  PYMENTOR_PROVIDER_MASTER_KEY=' + MasterKey + #13#10
         + '  PYMENTOR_INITIAL_ADMIN_EMAIL=' + AdminEmail + #13#10
         + '  PYMENTOR_INITIAL_ADMIN_PASSWORD=(your password)' + #13#10
         + '目录：' + BackendDir,
           mbInformation, MB_OK);
  end;

  // 4. Surface status + next steps.
  Msg := '后端部署包已解压到：' + #13#10
       + BackendDir + #13#10 + #13#10
       + 'Docker 状态：' + DockerStatus + #13#10 + #13#10
       + '系统环境变量已设置：' + #13#10
       + '  PYMENTOR_DESKTOP_WEB_URL = ' + GetDesktopWebUrl('') + #13#10
       + '（重启桌面应用后生效）' + #13#10 + #13#10;

  case DockerCode of
    0: Msg := Msg + '现在可以一键启动后端（deploy.ps1 会自动检测端口占用）。';
    1: Msg := Msg + '尚未安装 Docker Desktop。请安装后双击 deploy.ps1：' + #13#10 + DOCKER_DOWNLOAD_URL;
    2: Msg := Msg + 'Docker 守护进程未运行。请启动 Docker Desktop 后双击 deploy.ps1。';
    3: Msg := Msg + 'docker compose 插件缺失。请更新 Docker Desktop 后双击 deploy.ps1。';
  else
    Msg := Msg + 'Docker 检查异常（代码 ' + IntToStr(DockerCode) + '）。请稍后手动运行 deploy.ps1。';
  end;
  MsgBox(Msg, mbInformation, MB_OK);

  // 5. Offer to launch deploy.ps1 immediately when Docker is ready.
  if DockerReady then begin
    LaunchDeploy := MsgBox('是否立即部署后端？' + #13#10
                         + 'deploy.ps1 将构建镜像、检测端口占用、并启动 Docker 服务栈。',
                           mbConfirmation, MB_YESNO or MB_DEFBUTTON1);
    if LaunchDeploy = IDYES then begin
      // Launch in a visible window so the user sees build progress + port
      // prompts. runhidden is intentionally NOT used here.
      ShellExec('open', 'powershell.exe',
                '-NoProfile -ExecutionPolicy Bypass -File "' + BackendDir + '\deploy.ps1"',
                BackendDir, SW_SHOW, ewNoWait, ResultCode);
    end;
  end;

  // 6. Offer to open the unpacked folder for manual inspection.
  OpenFolder := MsgBox('是否打开后端部署目录？', mbConfirmation, MB_YESNO or MB_DEFBUTTON2);
  if OpenFolder = IDYES then begin
    ShellExec('open', BackendDir, '', '', SW_SHOW, ewNoWait, ResultCode);
  end;
end;

// ===========================================================================
// Uninstall: [Registry] uninsdeletevalue already removed PYMENTOR_DESKTOP_WEB_URL.
// Here we offer to tear down the backend stack + delete the kit + volumes.
// ===========================================================================
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  ResultCode: Integer;
  BackendDir: String;
  Choice: Integer;
begin
  if CurUninstallStep <> usPostUninstall then Exit;
  BackendDir := ExpandConstant('{userdocs}\PyMentorLab-Backend');
  if DirExists(BackendDir) then begin
    Choice := MsgBox('是否同时删除后端部署目录与数据？' + #13#10
                    + '(此操作不可撤销，将丢失所有课程/学生数据)' + #13#10 + #13#10
                    + BackendDir,
                    mbConfirmation, MB_YESNO or MB_DEFBUTTON2);
    if Choice = IDYES then begin
      // Stop the stack first if it is running (ignore errors).
      if Exec(ExpandConstant('{cmd}'),
              '/c powershell.exe -NoProfile -Command "cd ''' + BackendDir + '''; docker compose down -v 2>$null"',
              '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then begin
        ; // intentionally ignore
      end;
      DelTree(BackendDir, True, True, True);
    end;
  end;
end;
