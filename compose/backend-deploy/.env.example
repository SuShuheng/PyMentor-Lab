# ===========================================================================
#  PyMentor Lab - Backend deployment environment (self-contained kit)
#  --------------------------------------------------------------------------
#  Copy to .env and adjust. NEVER commit the real .env (gitignored).
#
#  Required before first `deploy.ps1` run:
#    - PYMENTOR_PROVIDER_MASTER_KEY       (generate with the command below)
#    - PYMENTOR_INITIAL_ADMIN_EMAIL       (must be a deliverable email)
#    - PYMENTOR_INITIAL_ADMIN_PASSWORD    (min 8 characters)
#
#  The desktop shell reads PYMENTOR_DESKTOP_WEB_URL from the *machine*
#  environment (set by the Bootstrapper) so it does NOT need to be in this
#  file. It is documented here for reference.
# ===========================================================================

# ---- PostgreSQL ----
POSTGRES_USER=pymentor
POSTGRES_PASSWORD=pymentor_dev
POSTGRES_DB=pymentor

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=pymentor
MINIO_ROOT_PASSWORD=pymentor_dev

# ---- API service ----
PYMENTOR_SERVICE_NAME=api
PYMENTOR_SERVICE_VERSION=0.0.0
PYMENTOR_LOG_LEVEL=INFO

# ---- Database (BE-002) ----
# Host-side connection string. Inside Compose, the api/worker services override
# this to point at the `postgres` service hostname.
PYMENTOR_DATABASE_URL=postgresql+psycopg://pymentor:pymentor_dev@127.0.0.1:5432/pymentor

# ---- JWT (BE-002) ----
# Generate a strong secret in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
PYMENTOR_JWT_SECRET=dev-only-insecure-secret-change-me-in-production-min-32-bytes
PYMENTOR_JWT_ALGORITHM=HS256
PYMENTOR_ACCESS_TOKEN_TTL_MINUTES=15
PYMENTOR_REFRESH_TOKEN_TTL_DAYS=7

# ---- Provider credential encryption (BE-010) ----
# REQUIRED before first run. Generate a URL-safe base64 AES-256 key and keep
# it stable for the lifetime of encrypted Provider rows:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PYMENTOR_PROVIDER_MASTER_KEY=

# ---- Initial System Admin bootstrap (BE-002, BE-029, design §17.3.1) ----
# REQUIRED before first run. Leave both empty to skip bootstrap (useful for
# subsequent redeploys). When set, an admin account is created on first startup.
# BE-029: PYMENTOR_INITIAL_ADMIN_EMAIL must be a deliverable email address. The
# same Pydantic EmailStr validation that /api/v1/auth/login enforces is applied
# at bootstrap time, so an invalid value (e.g. "admin" with no @-sign, or a
# reserved TLD like .local) fails loudly at startup instead of silently creating
# an account that can never log in. Use a resolvable domain such as
# admin@pymentor.dev or admin@example.com; avoid admin@*.local.
PYMENTOR_INITIAL_ADMIN_EMAIL=
PYMENTOR_INITIAL_ADMIN_PASSWORD=

# ---- Bootstrap control ----
PYMENTOR_BOOTSTRAP_ON_STARTUP=true

# ---- Worker ----
PYMENTOR_WORKER_PORT=8081
PYMENTOR_REDIS_URL=redis://127.0.0.1:6379/0
PYMENTOR_AGENT_EVENT_CONSUMER_ENABLED=false
PYMENTOR_AGENT_EVENT_STREAM=pymentor:agent-events:v1
PYMENTOR_AGENT_EVENT_GROUP=pymentor-api-v1
PYMENTOR_AGENT_EVENT_CONSUMER=api-1
PYMENTOR_AGENT_EVENT_BLOCK_MS=1000
PYMENTOR_AGENT_EVENT_BATCH_SIZE=25
PYMENTOR_AGENT_EVENT_CLAIM_IDLE_MS=30000
PYMENTOR_WORKER_HEALTH_URL=http://127.0.0.1:8081/ready
PYMENTOR_WORKER_RESOURCE_URL=http://127.0.0.1:8081/internal/v1/resource-generation
# Internal API-to-Worker authentication secret. Generate independently for each deployment.
PYMENTOR_WORKER_INTERNAL_SECRET=dev-only-insecure-worker-secret-change-me-min-32-bytes
PYMENTOR_OPERATIONAL_LOG_PERSISTENCE_ENABLED=false
REDIS_URL=redis://redis:6379/0

# ---- Sandbox Supervisor (BE-005) ----
PYMENTOR_SANDBOX_SECRET=dev-only-insecure-sandbox-secret-change-me-min-32-bytes
PYMENTOR_SANDBOX_RUNTIME_IMAGE=pymentor/sandbox-runtime:1.0
PYMENTOR_SANDBOX_SUPERVISOR_URL=http://sandbox:8090
PYMENTOR_SANDBOX_REQUEST_TIMEOUT_SECONDS=30

# ---- Object storage ----
PYMENTOR_OBJECT_STORE_ENDPOINT=127.0.0.1:9000
PYMENTOR_OBJECT_STORE_ACCESS_KEY=pymentor
PYMENTOR_OBJECT_STORE_SECRET_KEY=pymentor_dev
PYMENTOR_OBJECT_STORE_BUCKET=pymentor-resources
PYMENTOR_OBJECT_STORE_SECURE=false

# ---- Browser origins ----
# Use 127.0.0.1 only (per deployment convention) - localhost variants removed
# to keep the CORS allowlist deterministic.
PYMENTOR_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:4174

# ===========================================================================
#  Desktop shell wiring (reference only — set by the Bootstrapper on Windows)
#  --------------------------------------------------------------------------
#  The PyMentor Lab desktop app loads this URL on startup. When the backend is
#  deployed on the same machine, the Bootstrapper sets it to:
#    PYMENTOR_DESKTOP_WEB_URL=http://127.0.0.1:4173
#  When the backend is deployed to another host, edit the machine environment
#  variable (System Properties > Environment Variables) to point at the student
#  web frontend, e.g.:
#    PYMENTOR_DESKTOP_WEB_URL=https://learn.example.edu/app
#  This value MUST NOT be placed in this .env (Docker never reads it).
# ===========================================================================
