{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"]
  },
  // src/index.ts imports the generated SDK, so tsc checks its complete public
  // graph. The exclusion only prevents generated files becoming extra roots.
  "include": ["src/index.ts"],
  "exclude": ["src/generated/**", "src/**/*.test.ts"]
}
