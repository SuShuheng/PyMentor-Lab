    "/api/v1/admin/registrations/pending": {
      "get": {
        "description": "\u5217\u51fa\u5f85\u5ba1\u6838\u6ce8\u518c\uff08\u5206\u9875\uff09\u3002\u4ec5\u7ba1\u7406\u7aef\u53ef\u8bbf\u95ee\u3002",
        "operationId": "list_pending_api_v1_admin_registrations_pending_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PendingRegistration"
                  },
                  "title": "Response List Pending Api V1 Admin Registrations Pending Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Pending",
        "tags": [
          "admin"
        ]
      }
    },
