      "RegisterRequest": {
        "additionalProperties": false,
        "description": "\u5b66\u751f\u81ea\u52a9\u6ce8\u518c\u8bf7\u6c42\uff08\u8bbe\u8ba1 \u00a717.3.1\uff09\u3002\u6ce8\u518c\u5373 PENDING\u3002",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 72,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "student_no": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
