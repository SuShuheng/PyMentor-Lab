              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "title": "RegistrationDecisionRequest",
        "type": "object"
      },
      "SystemPingResponse": {
        "additionalProperties": false,
