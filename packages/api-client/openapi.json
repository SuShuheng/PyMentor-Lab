            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "TokenRefreshRequest",
        "type": "object"
      },
      "UserProfile": {
        "additionalProperties": false,
        "description": "\u5f53\u524d\u7528\u6237\u4fe1\u606f\uff08GET /auth/me\uff09\u3002\u4e0d\u542b\u5bc6\u7801\u54c8\u5e0c\u3002",
        "properties": {
