{
  "components": {
    "schemas": {
      "AuthTokens": {
        "additionalProperties": false,
        "description": "\u4ee4\u724c\u5bf9\u3002access_token \u77ed\u671f\uff0crefresh_token \u957f\u671f\uff08\u8bbe\u8ba1 \u00a717.3.3\uff09\u3002",
        "properties": {
          "access_token": {
            "minLength": 1,
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "access token \u6709\u6548\u671f\uff08\u79d2\uff09",
            "minimum": 1.0,
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "AuthTokens",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Body of ``GET /health``.",
        "properties": {
          "service": {
            "minLength": 1,
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "timestamp": {
            "minLength": 1,
            "title": "Timestamp",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "timestamp"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "degraded",
          "down"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "\u767b\u5f55\u8bf7\u6c42\uff08\u5b66\u751f/\u7ba1\u7406\u5458\u901a\u7528\uff09\u3002",
