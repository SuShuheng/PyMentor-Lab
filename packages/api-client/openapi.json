            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "message"
        ],
        "title": "RegisterResponse",
        "type": "object"
      },
      "RegistrationDecisionRequest": {
        "additionalProperties": false,
        "description": "\u7ba1\u7406\u5458\u5ba1\u6838\u51b3\u5b9a\uff08\u6279\u51c6/\u62d2\u7edd\uff09\u3002",
        "properties": {
          "reason": {
