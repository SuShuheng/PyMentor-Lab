        "additionalProperties": false,
        "description": "\u6ce8\u518c\u6210\u529f\u54cd\u5e94\u3002status \u6052\u4e3a PENDING\uff0c\u5f85\u7ba1\u7406\u5458\u5ba1\u6838\u3002",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "status": {
            "const": "PENDING",
            "default": "PENDING",
