            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "service",
          "timestamp"
        ],
        "title": "SystemPingResponse",
        "type": "object"
      },
      "TokenRefreshRequest": {
        "additionalProperties": false,
        "description": "\u5237\u65b0\u4ee4\u724c\u8bf7\u6c42\u3002",
        "properties": {
