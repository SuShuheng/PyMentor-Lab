{
  "name": "@pymentor/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared, versioned wire schemas: the frozen Pydantic ↔ Zod contract boundary.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:check": "tsx src/export-json-schema.ts && tsx src/conformance.ts"
  },
  "dependencies": {
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
