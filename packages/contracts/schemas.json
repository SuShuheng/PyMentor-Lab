              "event_id",
              "chunk"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "reasoning_delta"
              },
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "chunk": {
                "$ref": "#/definitions/StreamEvent/anyOf/0/properties/chunk"
              }
            },
            "required": [
              "type",
              "event_id",
              "chunk"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
