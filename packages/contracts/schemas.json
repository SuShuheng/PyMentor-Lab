  "StreamEvent": {
    "$ref": "#/definitions/StreamEvent",
    "definitions": {
      "StreamEvent": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "content_delta"
              },
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "chunk": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "chunk_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "delta_content": {
                    "type": "string"
                  },
                  "delta_reasoning": {
                    "type": "string"
                  },
