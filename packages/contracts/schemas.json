  "SandboxResult": {
    "$ref": "#/definitions/SandboxResult",
    "definitions": {
      "SandboxResult": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "ERROR",
              "TIMEOUT",
              "CANCELLED"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "passed": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string"
                },
                "stdout": {
                  "type": "string"
                },
                "stderr": {
                  "type": "string"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "passed",
                "duration_ms"
              ],
              "additionalProperties": false
            }
          },
          "trace": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "call",
                    "line",
                    "return",
                    "exception"
                  ]
                },
                "func_name": {
                  "type": "string",
                  "minLength": 1
                },
                "locals": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "line",
                "event",
                "func_name"
              ],
              "additionalProperties": false
            }
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "peak_memory_kb": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "user_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform_error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "run_id",
          "status",
          "passed",
          "stdout",
          "stderr",
          "tests",
          "duration_ms",
          "peak_memory_kb",
          "user_error",
          "platform_error"
        ],
        "additionalProperties": false
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
