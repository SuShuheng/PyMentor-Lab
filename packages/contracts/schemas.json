                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string"
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "type",
              "event_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
