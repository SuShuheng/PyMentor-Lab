# PyMentor Lab local development environment.
#
# Copy to `.env` and adjust. NEVER commit the real `.env` (it is gitignored).
# No production secrets belong here — only local development defaults.

# ---- PostgreSQL ----
POSTGRES_USER=pymentor
POSTGRES_PASSWORD=pymentor_dev
POSTGRES_DB=pymentor

# ---- MinIO (object storage) ----
MINIO_ROOT_USER=pymentor
MINIO_ROOT_PASSWORD=pymentor_dev

# ---- API service ----
PYMENTOR_SERVICE_NAME=api
PYMENTOR_SERVICE_VERSION=0.0.0
PYMENTOR_LOG_LEVEL=INFO

# ---- Worker ----
PYMENTOR_WORKER_PORT=8081
REDIS_URL=redis://redis:6379/0
