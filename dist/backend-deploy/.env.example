# PyMentor Lab v1.1 — deployment environment template.
#
# Copy this file to `.env` and edit before running `./deploy.sh` (or deploy.ps1).
# The deploy script will NOT auto-start with default secrets; it exits and asks
# you to set the three values marked [REQUIRED] below.
#
# Generation commands assume Python 3 is available locally. If you only have
# Docker, run them in a throwaway container, e.g.:
#   docker run --rm python:3.13-alpine python -c "import secrets; print(secrets.token_urlsafe(48))"

# ============================================================================
# PostgreSQL
# ============================================================================
# Change POSTGRES_PASSWORD in production. The password is used by the API,
# the `psql` restore/backup scripts, and any external SQL client you connect
# on port 5432.
POSTGRES_USER=pymentor
POSTGRES_PASSWORD=pymentor_dev
POSTGRES_DB=pymentor

# ============================================================================
# MinIO (object storage for student uploads / generated resources)
# ============================================================================
MINIO_ROOT_USER=pymentor
MINIO_ROOT_PASSWORD=pymentor_dev

# ============================================================================
# Service settings
# ============================================================================
PYMENTOR_SERVICE_NAME=api
PYMENTOR_SERVICE_VERSION=1.1.0
PYMENTOR_LOG_LEVEL=INFO

# ---- Database (host-side URL — used by host-run tooling, NOT by the API) ----
# The host stays `localhost` because this URL is for CLI/admin tooling running
# on the host, hitting the published port 5432. The in-Compose API service
# uses its own internal URL (see docker-compose.yml `api.environment`).
# To change the host port, edit docker-compose.yml `postgres.ports` AND this URL.
PYMENTOR_DATABASE_URL=postgresql+psycopg://pymentor:pymentor_dev@localhost:5432/pymentor

# ============================================================================
# JWT signing secret
# ============================================================================
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PYMENTOR_JWT_SECRET=dev-only-insecure-secret-change-me-in-production-min-32-bytes
PYMENTOR_JWT_ALGORITHM=HS256
PYMENTOR_ACCESS_TOKEN_TTL_MINUTES=15
PYMENTOR_REFRESH_TOKEN_TTL_DAYS=7

# ============================================================================
# Provider credential encryption key (BE-010)                  [REQUIRED]
# ============================================================================
# Encrypts stored API keys for LLM / OCR / ASR / TTS providers. Generate a
# URL-safe base64 AES-256 key and KEEP IT STABLE for the lifetime of encrypted
# Provider rows (rotating it requires re-encrypting every Provider credential):
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PYMENTOR_PROVIDER_MASTER_KEY=

# ============================================================================
# Initial System Admin bootstrap (BE-002, BE-029, design §17.3.1)  [REQUIRED]
# ============================================================================
# Leave empty to skip bootstrap. Set BOTH to create the first admin on startup.
# PYMENTOR_INITIAL_ADMIN_EMAIL must be a deliverable email address. The same
# Pydantic EmailStr validation that /api/v1/auth/login enforces is applied at
# bootstrap time, so an invalid value (e.g. "admin" with no @-sign, or a
# reserved TLD like .local) fails loudly at startup instead of silently
# creating an account that can never log in. Use a resolvable domain such as
# admin@pymentor.dev or admin@example.com; avoid admin@*.local.
PYMENTOR_INITIAL_ADMIN_EMAIL=
PYMENTOR_INITIAL_ADMIN_PASSWORD=

# ---- Bootstrap control ----
PYMENTOR_BOOTSTRAP_ON_STARTUP=true

# ============================================================================
# Worker (resource generation pipeline)
# ============================================================================
PYMENTOR_WORKER_PORT=8081
PYMENTOR_REDIS_URL=redis://127.0.0.1:6379/0
PYMENTOR_AGENT_EVENT_CONSUMER_ENABLED=false
PYMENTOR_AGENT_EVENT_STREAM=pymentor:agent-events:v1
PYMENTOR_AGENT_EVENT_GROUP=pymentor-api-v1
PYMENTOR_AGENT_EVENT_CONSUMER=api-1
PYMENTOR_AGENT_EVENT_BLOCK_MS=1000
PYMENTOR_AGENT_EVENT_BATCH_SIZE=25
PYMENTOR_AGENT_EVENT_CLAIM_IDLE_MS=30000
PYMENTOR_WORKER_HEALTH_URL=http://127.0.0.1:8081/ready
PYMENTOR_WORKER_RESOURCE_URL=http://127.0.0.1:8081/internal/v1/resource-generation
# Internal API-to-Worker authentication secret. Generate independently for each deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PYMENTOR_WORKER_INTERNAL_SECRET=dev-only-insecure-worker-secret-change-me-min-32-bytes
PYMENTOR_OPERATIONAL_LOG_PERSISTENCE_ENABLED=false
REDIS_URL=redis://redis:6379/0

# ============================================================================
# Sandbox Supervisor (BE-005)
# ============================================================================
# HMAC shared secret used to sign internal execution requests between the API
# and the Supervisor. MUST be at least 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PYMENTOR_SANDBOX_SECRET=dev-only-insecure-sandbox-secret-change-me-min-32-bytes
# Pinned runtime image reference (never :latest). The Supervisor passes
# --pull never so a missing image is a deterministic platform error.
PYMENTOR_SANDBOX_RUNTIME_IMAGE=pymentor/sandbox-runtime:1.0
PYMENTOR_SANDBOX_SUPERVISOR_URL=http://sandbox:8090
PYMENTOR_SANDBOX_REQUEST_TIMEOUT_SECONDS=30

# ============================================================================
# Object storage (MinIO) — host-side endpoint
# ============================================================================
PYMENTOR_OBJECT_STORE_ENDPOINT=localhost:9000
PYMENTOR_OBJECT_STORE_ACCESS_KEY=pymentor
PYMENTOR_OBJECT_STORE_SECRET_KEY=pymentor_dev
PYMENTOR_OBJECT_STORE_BUCKET=pymentor-resources
PYMENTOR_OBJECT_STORE_SECURE=false

# ============================================================================
# Browser origins (CORS)
# ============================================================================
# If you change the Web (4173) or Admin (4174) host ports in docker-compose.yml,
# update the matching origins here so the browser can call the API.
PYMENTOR_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4174,http://localhost:4174

# ============================================================================
# PORT MAP (host-side, all bound to 127.0.0.1)
# ============================================================================
#   5432  PostgreSQL     — change here AND in PYMENTOR_DATABASE_URL
#   8000  FastAPI        — admin login at http://localhost:8000/docs
#   4173  Web app        — student SPA; also update PYMENTOR_CORS_ALLOWED_ORIGINS
#   4174  Admin app      — operator SPA; also update PYMENTOR_CORS_ALLOWED_ORIGINS
#   6379  Redis          — usually leave alone
#   9000  MinIO S3 API   — also update PYMENTOR_OBJECT_STORE_ENDPOINT
#   9001  MinIO Console  — web UI
#   8081  Worker         — internal health/metrics
